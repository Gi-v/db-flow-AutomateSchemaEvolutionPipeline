{
  "dashboard": {
    "title": "Mini Relational DBMS Dashboard",
    "panels": [
      {
        "title": "Request Rate",
        "targets": [
          {
            "expr": "rate(minidb_requests_total[5m])"
          }
        ]
      },
      {
        "title": "Query Duration",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(minidb_query_duration_seconds_bucket[5m]))"
          }
        ]
      }
    ]
  }
}
